with 
rs as 
(select name,listagg(distinct resources,',') as used_resources from entries 
group by name),
mv as 
(select name,floor,count(1) as most_no_of_visit,
dense_rank() over(partition by name order by count(1) desc) as rk 
from entries 
group by name,floor  
order by name) 
select mv.name,mv.floor,mv.most_no_of_visit,rs.used_resources from mv
inner join rs on mv.name = rs.name 
where mv.rk = 1;
